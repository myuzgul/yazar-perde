generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                @id @default(cuid())
  name                      String
  surname                   String
  email                     String                @unique
  phone                     String?
  passwordHash              String
  role                      String                @default("CUSTOMER")
  isEmailVerified           Boolean               @default(false)
  isDeleted                 Boolean               @default(false)
  defaultDeliveryAddressId  String?
  defaultBillingAddressId   String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  orders                    Order[]
  addresses                 Address[]
  passwordResetTokens       PasswordResetToken[]

  @@map("users")
}

model Address {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  addressType         String      @default("INDIVIDUAL")
  name                String
  surname             String
  companyName         String?
  taxNo               String?
  taxOffice           String?
  phone               String
  city                String
  district            String
  fullAddress         String
  postalCode          String?
  isDefaultDelivery   Boolean     @default(false)
  isDefaultBilling    Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("addresses")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("password_reset_tokens")
}

model Category {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String?
  imageUrl      String?
  parentId      String?
  parent        Category?   @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children      Category[]  @relation("CategoryChildren")
  showInMenu    Boolean     @default(true)
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  seoTitle      String?
  seoDesc       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  products      Product[]

  @@map("categories")
}

model Brand {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  logoUrl       String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@map("brands")
}

model ProductTag {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  badgeColor    String    @default("#1B84F8")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@map("product_tags")
}

model Product {
  id            String        @id @default(cuid())
  name          String
  sku           String        @unique
  slug          String        @unique
  curtainType   String
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?        @relation(fields: [brandId], references: [id])
  tagId         String?
  tag           ProductTag?   @relation(fields: [tagId], references: [id])
  
  basePrice     Float
  discountPrice Float?
  vatRate       Float         @default(10)
  
  stockTracking Boolean       @default(false)
  stockQuantity Int           @default(0)
  isActive      Boolean       @default(true)
  isFeatured    Boolean       @default(true)
  sortOrder     Int           @default(0)

  minWidth      Float         @default(30)
  maxWidth      Float         @default(500)
  minHeight     Float         @default(50)
  maxHeight     Float         @default(350)

  shortDesc         String?
  descriptionHtml   String?
  mountingVideoUrl  String?
  mountingGuideHtml String?
  
  seoTitle      String?
  seoDesc       String?
  seoKeywords   String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  images        ProductImage[]
  orderItems    OrderItem[]
  reviews       ProductReview[]

  @@map("products")
}

model ProductImage {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl      String
  thumbnailUrl  String?
  sortOrder     Int       @default(0)
  isCover       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@map("product_images")
}

model SystemSetting {
  id            String    @id @default(cuid())
  key           String    @unique
  value         String
  label         String
  group         String
  description   String?
  updatedAt     DateTime  @updatedAt

  @@map("system_settings")
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          String          @default("PENDING")
  paymentMethod   String          @default("PAYTR_CC")
  paymentStatus   String          @default("PENDING")
  
  customerName    String
  customerSurname String
  customerEmail   String
  customerPhone   String
  customerNote    String?
  adminNote       String?

  subtotal        Float
  shippingFee     Float           @default(0)
  paymentFee      Float           @default(0)
  discountTotal   Float           @default(0)
  couponCode      String?
  vatTotal        Float           @default(0)
  grandTotal      Float

  isPrinted       Boolean         @default(false)
  printedAt       DateTime?
  printCount      Int             @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  items           OrderItem[]
  addresses       OrderAddress[]
  timeline        OrderTimeline[]

  @@map("orders")
}

model OrderAddress {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  isBilling     Boolean     @default(false)
  addressType   String      @default("INDIVIDUAL")
  name          String
  surname       String
  companyName   String?
  taxNo         String?
  taxOffice     String?
  phone         String
  city          String
  district      String
  fullAddress   String
  createdAt     DateTime    @default(now())

  @@map("order_addresses")
}

model OrderItem {
  id                        String      @id @default(cuid())
  orderId                   String
  order                     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                 String?
  product                   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName               String
  productSku                String
  curtainType               String
  
  width                     Float
  height                    Float
  quantity                  Int         @default(1)
  calculatedArea            Float
  
  selectedOptionsSnapshot   String
  pricingBreakdownSnapshot  String
  
  unitPrice                 Float
  totalPrice                Float
  itemNote                  String?

  createdAt                 DateTime    @default(now())

  @@map("order_items")
}

model OrderTimeline {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        String
  title         String
  description   String?
  createdAt     DateTime    @default(now())

  @@map("order_timeline")
}

model StoryBanner {
  id            String      @id @default(cuid())
  title         String
  imageUrl      String
  targetUrl     String?
  bannerType    String      @default("STORY")
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("story_banners")
}

model NotificationTemplate {
  id            String      @id @default(cuid())
  code          String      @unique
  title         String
  smsBody       String
  emailSubject  String
  emailHtmlBody String
  isActive      Boolean     @default(true)
  updatedAt     DateTime    @updatedAt

  @@map("notification_templates")
}

model StaticPage {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  contentHtml   String
  seoTitle      String?
  seoDesc       String?
  isActive      Boolean     @default(true)
  updatedAt     DateTime    @updatedAt

  @@map("static_pages")
}

model ProductReview {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName  String
  rating        Int         @default(5)
  comment       String
  imageUrl      String?
  isApproved    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("product_reviews")
}

model Coupon {
  id                    String        @id @default(cuid())
  code                  String        @unique
  title                 String?
  description           String?
  discountType          String        @default("PERCENTAGE") // PERCENTAGE | FIXED_AMOUNT | FREE_SHIPPING
  discountValue         Float         // e.g. 10 (%10) or 150 (150 TL)
  minOrderAmount        Float?        // Minimum cart total to apply coupon
  maxDiscountAmount     Float?        // Cap for percentage discounts (e.g. max 500 TL)
  usageLimit            Int?          // Total allowed usages across all users
  usageCount            Int           @default(0)
  perUserLimit          Int?          @default(1) // Max usages per customer email
  startDate             DateTime?
  endDate               DateTime?
  isActive              Boolean       @default(true)
  firstOrderOnly        Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  usages                CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id          String    @id @default(cuid())
  couponId    String
  coupon      Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId     String?
  userEmail   String
  discount    Float
  createdAt   DateTime  @default(now())

  @@map("coupon_usages")
}
